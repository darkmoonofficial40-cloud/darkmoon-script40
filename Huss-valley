local function BuildPaletteFromColor(col)
	local h, s, v = col:ToHSV()
	return {
		Primary = col,
		Secondary = Color3.fromHSV(h, math.clamp(s * 0.65, 0, 1), math.clamp(v + 0.12, 0, 1)),
		SoftBg = Color3.fromHSV(h, math.clamp(s * 0.6, 0, 1), 0.16),
	}
end

local function ParseColorInput(rawText)
	if typeof(rawText) ~= "string" then return nil end
	local trimmed = rawText:match("^%s*(.-)%s*$")
	if not trimmed or trimmed == "" then return nil end

	local hex = trimmed:match("^#?(%x%x%x%x%x%x)$")
	if hex then
		local r = tonumber(hex:sub(1, 2), 16)
		local g = tonumber(hex:sub(3, 4), 16)
		local b = tonumber(hex:sub(5, 6), 16)
		if r and g and b then
			return Color3.fromRGB(r, g, b)
		end
	end

	local rStr, gStr, bStr = trimmed:match("^(%d%d?%d?)%s*[,%s]%s*(%d%d?%d?)%s*[,%s]%s*(%d%d?%d?)$")
	if rStr and gStr and bStr then
		local r = math.clamp(tonumber(rStr) or 0, 0, 255)
		local g = math.clamp(tonumber(gStr) or 0, 0, 255)
		local b = math.clamp(tonumber(bStr) or 0, 0, 255)
		return Color3.fromRGB(r, g, b)
	end

	return nil
end

local function SnapStep(value, minVal, maxVal, step)
	local s = step or 0.05
	local snapped = minVal + math.floor(((value - minVal) / s) + 0.5) * s
	return math.clamp(math.round(snapped * 100) / 100, minVal, maxVal)
end

local function GetCharacterRig()
	local char = LocalPlayer.Character
	if not char then return nil, nil, nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return nil, nil, nil end
	return char, hum, root
end

local function HasThreatTool(container)
	if not container then return false end
	for _, item in ipairs(container:GetChildren()) do
		if item:IsA("Tool") then
			local lower = string.lower(item.Name)
			if string.find(lower, "chaser") or string.find(lower, "knife") or string.find(lower, "sword") or string.find(lower, "tag") then
				return true
			end
		end
	end
	return false
end

local function IsEnemyPlayer(localPlr, targetPlr)
	if not targetPlr or targetPlr == localPlr then return false end
	local targetChar = targetPlr.Character
	if HasThreatTool(targetPlr:FindFirstChild("Backpack")) or HasThreatTool(targetChar) then
		return true
	end

	local localRole = localPlr:GetAttribute("Role") or localPlr:GetAttribute("Team") or localPlr:GetAttribute("Status")
	local targetRole = targetPlr:GetAttribute("Role") or targetPlr:GetAttribute("Team") or targetPlr:GetAttribute("Status")
	if localRole and targetRole then
		return localRole ~= targetRole
	end

	if localPlr.Team and targetPlr.Team then
		return localPlr.Team ~= targetPlr.Team
	end

	if targetChar and (targetChar:FindFirstChild("Chaser") or targetChar:FindFirstChild("Tag") or targetChar:FindFirstChild("It") or targetChar:FindFirstChild("Enemy")) then
		return true
	end

	return true
end

local function RefreshEnemyCache()
	table.clear(CachedEnemies)
	for _, plr in ipairs(Players:GetPlayers()) do
		if IsEnemyPlayer(LocalPlayer, plr) then
			table.insert(CachedEnemies, plr)
		end
	end
end

local function DestroyUnderMapFloor()
	if UnderMapFloor then
		UnderMapFloor:Destroy()
		UnderMapFloor = nil
	end
end

local function EnsureUnderMapFloor()
	if not UnderMapFloor or not UnderMapFloor.Parent then
		local part = Instance.new("Part")
		part.Name = "DarkMoonUnderFloor"
		part.Size = Vector3.new(28, 1, 28)
		part.Anchored = true
		part.CanCollide = true
		part.Transparency = 1
		part.Parent = workspace
		UnderMapFloor = part
	end
	return UnderMapFloor
end

local function DropUnderMap()
	local char, _, root = GetCharacterRig()
	if not root then return end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char, UnderMapFloor }

	local hit = workspace:Raycast(root.Position + Vector3.new(0, 4, 0), Vector3.new(0, -140, 0), rayParams)
	local targetY = hit and (hit.Position.Y - State.UnderMapDepth) or (root.Position.Y - State.UnderMapDepth)

	root.CFrame = CFrame.new(root.Position.X, targetY, root.Position.Z)
	if State.SafeFloor then
		local floor = EnsureUnderMapFloor()
		floor.CFrame = CFrame.new(root.Position.X, targetY - 3.5, root.Position.Z)
	end
end

local function RiseToSurface()
	local char, _, root = GetCharacterRig()
	if not root then return end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char, UnderMapFloor }

	local hit = workspace:Raycast(root.Position, Vector3.new(0, 180, 0), rayParams)
	if hit then
		root.CFrame = CFrame.new(root.Position.X, hit.Position.Y + 4, root.Position.Z)
	else
		root.CFrame = root.CFrame + Vector3.new(0, State.UnderMapDepth + 4, 0)
	end
	DestroyUnderMapFloor()
end

local function SetUnderMapActive(enabled)
	State.UnderMap = enabled
	if enabled then
		DropUnderMap()
	else
		RiseToSurface()
	end
end

local function SetESPActive(enabled)
	State.ESP = enabled
	if not enabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character and plr.Character:FindFirstChild("DarkMoonESP") then
				plr.Character.DarkMoonESP:Destroy()
			end
		end
	end
end

local function SetFullbrightActive(enabled)
	State.Fullbright = enabled
	if enabled then
		Lighting.Ambient = Color3.fromRGB(255, 255, 255)
		Lighting.Brightness = 2
		Lighting.GlobalShadows = false
		Lighting.ClockTime = 14
	else
		Lighting.Ambient = Color3.fromRGB(128, 128, 128)
		Lighting.Brightness = 1
		Lighting.GlobalShadows = true
	end
end

