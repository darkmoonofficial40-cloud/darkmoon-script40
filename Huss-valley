-- Gameplay Loops
UserInputService.JumpRequest:Connect(function()
	if not State.InfiniteJump then return end
	local _, hum = GetCharacterRig()
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

LocalPlayer.CharacterAdded:Connect(function()
	DestroyUnderMapFloor()
	currentMoveVector = Vector3.zero
	if State.UnderMap then
		task.defer(DropUnderMap)
	end
end)

RunService.RenderStepped:Connect(function()
	local _, hum, root = GetCharacterRig()
	if not hum or not root then return end

	if State.Speed then
		local desired = 16 * State.SpeedLevel
		if hum.WalkSpeed ~= desired then
			hum.WalkSpeed = desired
		end
	elseif hum.WalkSpeed > 16 and hum.WalkSpeed <= 128 then
		hum.WalkSpeed = 16
	end

	if State.AutoRun then
		local cam = workspace.CurrentCamera
		local flat = cam and Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		if flat and flat.Magnitude > 0 then
			currentMoveVector = currentMoveVector:Lerp(flat.Unit, 0.22)
			hum:Move(currentMoveVector, true)
		end
	end

	if State.UnderMap and State.SafeFloor and UnderMapFloor then
		UnderMapFloor.CFrame = CFrame.new(root.Position.X, root.Position.Y - 3.5, root.Position.Z)
	end

	if State.AutoDodge and (tick() - LastDodgeTime > 0.4) then
		for _, enemyPlr in ipairs(CachedEnemies) do
			local enemyRoot = enemyPlr.Parent and enemyPlr.Character and enemyPlr.Character:FindFirstChild("HumanoidRootPart")
			if enemyRoot then
				local dist = (root.Position - enemyRoot.Position).Magnitude
				if dist <= State.DodgeRange then
					LastDodgeTime = tick()
					local away = root.Position - enemyRoot.Position
					local flatAway = Vector3.new(away.X, 0, away.Z)
					local dodgeDir = (flatAway.Magnitude > 0 and flatAway.Unit or -root.CFrame.LookVector)
					dodgeDir = Vector3.new(dodgeDir.X, 0.25, dodgeDir.Z).Unit
					root.AssemblyLinearVelocity = dodgeDir * State.DodgePower
					hum:ChangeState(Enum.HumanoidStateType.Freefall)
					break
				end
			end
		end
	end
end)

RunService.Stepped:Connect(function()
	if not (State.Noclip or State.UnderMap) then return end
	local char = LocalPlayer.Character
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			part.CanCollide = false
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(0.3)
		RefreshEnemyCache()

		if State.AntiStun then
			local _, hum = GetCharacterRig()
			if hum and (hum.PlatformStand or hum:GetState() == Enum.HumanoidStateType.Ragdoll) then
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end

		if State.Hitbox then
			for _, plr in ipairs(Players:GetPlayers()) do
				local hrp = plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					hrp.Size = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
					hrp.Transparency = 0.7
					hrp.BrickColor = BrickColor.new("Bright red")
					hrp.CanCollide = false
				end
			end
		end

		if State.ESP then
			for _, plr in ipairs(Players:GetPlayers()) do
				local tChar = plr ~= LocalPlayer and plr.Character
				if tChar and tChar:FindFirstChild("HumanoidRootPart") and not tChar:FindFirstChild("DarkMoonESP") then
					local highlight = Instance.new("Highlight")
					highlight.Name = "DarkMoonESP"
					highlight.FillColor = ActiveAccentColor
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.FillTransparency = 0.5
					highlight.Parent = tChar
				end
			end
		end
	end
end)

-- Dragging & Toggle Controls
local draggingWindow, winDragStart, winStartPos
HeaderBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = true
		winDragStart = input.Position
		winStartPos = MainFrame.Position
	end
end)

local draggingMoon, movedMoon, moonDragStart, moonStartPos
MobileMoonBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingMoon = true
		movedMoon = false
		moonDragStart = input.Position
		moonStartPos = MobileMoonBtn.Position
	end
end)

MobileMoonBtn.MouseButton1Click:Connect(function()
	if not movedMoon then
		MainFrame.Visible = not MainFrame.Visible
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		if draggingWindow then
			local delta = input.Position - winDragStart
			MainFrame.Position = UDim2.new(winStartPos.X.Scale, winStartPos.X.Offset + delta.X, winStartPos.Y.Scale, winStartPos.Y.Offset + delta.Y)
			ClampMainFramePosition()
		end
		if draggingMoon then
			local delta = input.Position - moonDragStart
			if delta.Magnitude > 6 then
				movedMoon = true
			end
			MobileMoonBtn.Position = UDim2.new(moonStartPos.X.Scale, moonStartPos.X.Offset + delta.X, moonStartPos.Y.Scale, moonStartPos.Y.Offset + delta.Y)
		end
		if draggingSizeSlider then
			UpdateSizeFromX(input.Position.X)
		end
		if activeSliderDrag then
			activeSliderDrag(input.Position.X)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingWindow = false
		draggingMoon = false
		draggingSizeSlider = false
		activeSliderDrag = nil
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.RightControl then
		MainFrame.Visible = not MainFrame.Visible
	end
end)

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(ApplyResponsiveLayout)
end

RefreshEnemyCache()
ApplyResponsiveLayout()
SetPanelScale(PanelScaleValue)
SwitchTab(CurrentTab)
