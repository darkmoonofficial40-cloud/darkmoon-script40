local function onCharacterAdded(character)
    stopFly()
    table.clear(originalCollision)

    local hum = character:WaitForChild("Humanoid", 10)
    if hum then
        hum.WalkSpeed = WALK_SPEED
    end

    task.wait(0.5)

    if espEnabled then
        refreshESP()
    end
end

player.CharacterAdded:Connect(onCharacterAdded)

if player.Character then
    task.spawn(onCharacterAdded, player.Character)
end

-- Monitor players joining and respawning

local function connectPlayer(p)
    if p == player then return end

    local connection = p.CharacterAdded:Connect(function(character)
        character:WaitForChild("HumanoidRootPart", 10)

        if espEnabled then
            applyESP(character)
        end
    end)

    characterConnections[p] = connection

    if p.Character and espEnabled then
        applyESP(p.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    connectPlayer(p)
end

Players.PlayerAdded:Connect(connectPlayer)

Players.PlayerRemoving:Connect(function(p)
    if characterConnections[p] then
        characterConnections[p]:Disconnect()
        characterConnections[p] = nil
    end
end)

--========================================================
-- MOVEMENT AND NOCLIP LOOP
--========================================================

RunService.Stepped:Connect(function()
    local character = player.Character
    if not character then return end

    local hum = character:FindFirstChildOfClass("Humanoid")

    if hum and hum.Health > 0 then
        if hum.WalkSpeed ~= WALK_SPEED then
            hum.WalkSpeed = WALK_SPEED
        end
    end

    if noclipEnabled then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalCollision[part] == nil then
                    originalCollision[part] = part.CanCollide
                end

                part.CanCollide = false
            end
        end
    end
end)

