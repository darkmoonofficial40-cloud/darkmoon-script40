local frames = 0
local lastUpdate = os.clock()
local fps = 60

RunService.RenderStepped:Connect(function()
    frames += 1

    local now = os.clock()

    if now - lastUpdate >= 1 then
        fps = frames
        frames = 0
        lastUpdate = now

        status.Text = string.format(
            "FPS: %d   |   PLAYERS: %d   |   ACTIVE: %d",
            fps,
            #Players:GetPlayers(),
            updateActive()
        )
    end
end)

