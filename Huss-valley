function refreshFeatures()
    for _, btn in pairs(tabButtons) do
        btn.BackgroundTransparency = 1
        btn.TextColor3 = MUTED
    end

    local selected = tabButtons[selectedTab]

    if selected then
        selected.BackgroundTransparency = 0
        selected.BackgroundColor3 = Color3.fromRGB(65, 20, 30)
        selected.TextColor3 = RED
    end

    header.Text = string.upper(selectedTab) .. " CONTROL"

    local query = string.lower(search.Text)

    for _, item in ipairs(featureObjects) do
        local matchesTab = item.Tab == selectedTab
        local matchesSearch = query == ""
            or string.find(string.lower(item.Name), query, 1, true) ~= nil

        item.Card.Visible = matchesTab and matchesSearch
    end

    for _, child in ipairs(featureList:GetChildren()) do
        if child:IsA("TextLabel") and child.Text:sub(1, 1) == "—" then
            child.Visible = (query == "")
        end
    end

    upButton.Visible = flyEnabled
    downButton.Visible = flyEnabled
end

