local function TweenObj(obj, props, duration)
	if not obj or not obj.Parent then return end
	TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function ClampMainFramePosition()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	local scale = MainUIScale.Scale
	local halfW = (MainFrame.Size.X.Offset * scale) * 0.5
	local halfH = (MainFrame.Size.Y.Offset * scale) * 0.5
	local margin = 10

	local centerX = vp.X * MainFrame.Position.X.Scale + MainFrame.Position.X.Offset
	local centerY = vp.Y * MainFrame.Position.Y.Scale + MainFrame.Position.Y.Offset

	MainFrame.Position = UDim2.new(
		0,
		math.clamp(centerX, margin + halfW, math.max(margin + halfW, vp.X - margin - halfW)),
		0,
		math.clamp(centerY, margin + halfH, math.max(margin + halfH, vp.Y - margin - halfH))
	)
end

local function ApplyResponsiveLayout()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local isCompact = (vp.X < 760) or (vp.Y < 520)

	local baseW = isCompact and math.clamp(vp.X - 24, 340, 560) or 640
	local baseH = isCompact and math.clamp(vp.Y - 24, 270, 370) or 430
	MainFrame.Size = UDim2.new(0, baseW, 0, baseH)

	local sideW = isCompact and math.clamp(math.floor(baseW * 0.30), 118, 165) or 175
	Sidebar.Size = UDim2.new(0, sideW, 1, 0)
	ContentArea.Size = UDim2.new(1, -sideW, 1, 0)
	ContentArea.Position = UDim2.new(0, sideW, 0, 0)

	MobileMoonBtn.Size = isCompact and UDim2.new(0, 44, 0, 44) or UDim2.new(0, 48, 0, 48)
	ClampMainFramePosition()
end

local function SetPanelScale(newScale)
	PanelScaleValue = SnapStep(newScale, MinPanelScale, MaxPanelScale, PanelScaleStep)
	MainUIScale.Scale = PanelScaleValue

	local pct = math.clamp((PanelScaleValue - MinPanelScale) / (MaxPanelScale - MinPanelScale), 0, 1)
	SizeFill.Size = UDim2.new(pct, 0, 1, 0)
	SizeThumb.Position = UDim2.new(pct, 0, 0.5, 0)
	SizeValueLabel.Text = tostring(math.round(PanelScaleValue * 100)) .. "%"
	ClampMainFramePosition()
end

local function UpdateSizeFromX(inputX)
	local absPos = SizeTrack.AbsolutePosition.X
	local absSize = math.max(SizeTrack.AbsoluteSize.X, 1)
	local pct = math.clamp((inputX - absPos) / absSize, 0, 1)
	SetPanelScale(MinPanelScale + (MaxPanelScale - MinPanelScale) * pct)
end

SizeTrack.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		draggingSizeSlider = true
		UpdateSizeFromX(input.Position.X)
	end
end)

local function ApplyPalette(palette, labelText)
	ActiveAccentColor = palette.Primary
	ActiveSecondaryColor = palette.Secondary
	ActiveSoftBg = palette.SoftBg

	TweenObj(MainStroke, { Color = ActiveAccentColor }, 0.22)
	TweenObj(TopGlow, { BackgroundColor3 = ActiveAccentColor }, 0.22)
	TweenObj(MoonIcon, { ImageColor3 = ActiveAccentColor }, 0.22)
	TweenObj(MobileMoonBtn, { ImageColor3 = ActiveAccentColor }, 0.22)
	TweenObj(MobileStroke, { Color = ActiveAccentColor }, 0.22)
	TweenObj(SettingsStroke, { Color = ActiveAccentColor }, 0.22)
	TweenObj(ApplyBtn, { BackgroundColor3 = ActiveAccentColor }, 0.22)
	TweenObj(SizeFill, { BackgroundColor3 = ActiveAccentColor }, 0.22)
	SizeValueLabel.TextColor3 = ActiveSecondaryColor
	FeatureScroll.ScrollBarImageColor3 = ActiveAccentColor
	SettingsPanel.ScrollBarImageColor3 = ActiveAccentColor
	StatusLabel.TextColor3 = ActiveSecondaryColor

	if labelText then
		StatusLabel.Text = labelText
	end

	for name, btnData in pairs(TabButtons) do
		local selected = (name == CurrentTab)
		TweenObj(btnData.Button, {
			BackgroundColor3 = selected and ActiveSoftBg or Color3.fromRGB(20, 23, 34),
			BackgroundTransparency = selected and 0.15 or 1,
		}, 0.2)
		TweenObj(btnData.AccentBar, {
			BackgroundColor3 = ActiveAccentColor,
			BackgroundTransparency = selected and 0 or 1,
		}, 0.2)
		TweenObj(btnData.Label, {
			TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 158, 178),
		}, 0.2)
	end

	for pName, stroke in pairs(PresetStrokes) do
		TweenObj(stroke, {
			Transparency = (pName == CurrentTheme) and 0 or 0.85,
		}, 0.2)
	end

	for _, tData in ipairs(ActiveToggles) do
		if tData.GetState() then
			TweenObj(tData.Pill, { BackgroundColor3 = ActiveAccentColor }, 0.2)
			TweenObj(tData.Stroke, { Color = ActiveAccentColor }, 0.2)
		end
	end

	for _, sData in ipairs(ActiveSliders) do
		TweenObj(sData.Fill, { BackgroundColor3 = ActiveAccentColor }, 0.2)
		TweenObj(sData.Badge, { TextColor3 = ActiveSecondaryColor }, 0.2)
	end
end

