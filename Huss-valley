local function RenderTabContent(tabName)
	activeSliderDrag = nil
	for _, child in ipairs(FeatureScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	table.clear(ActiveToggles)
	table.clear(ActiveSliders)

	local isSettings = (tabName == "Settings")
	SettingsPanel.Visible = isSettings
	FeatureScroll.Visible = not isSettings
	FeatureScroll.CanvasPosition = Vector2.zero
	if isSettings then return end

	if tabName == "Option" then
		AddButtonRow(1, "Bring All", "Pull other players near you", "RUN", function()
			local _, _, root = GetCharacterRig()
			if not root then return end
			local dest = root.CFrame * CFrame.new(0, 0, -3)
			for _, plr in ipairs(Players:GetPlayers()) do
				local tRoot = plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if tRoot then
					tRoot.CFrame = dest
				end
			end
		end)
		AddButtonRow(2, "Rejoin", "Reconnect to this server", "RUN", function()
			TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
		end)
		AddButtonRow(3, "Server Hop", "Join another public server", "HOP", function()
			local api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(game:HttpGet(api))
			end)
			if ok and decoded and decoded.data then
				for _, srv in ipairs(decoded.data) do
					if srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
						TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id)
						break
					end
				end
			end
		end)
	elseif tabName == "Visual" then
		AddToggleRow(1, "Esp", "Highlight player silhouettes", function() return State.ESP end, SetESPActive)
		AddToggleRow(2, "Fullbright", "Brighten map lighting", function() return State.Fullbright end, SetFullbrightActive)
		AddSliderRow(3, "FOV", "Camera field of view", 70, 120, 1, "°", function() return State.FOV end, function(v)
			State.FOV = v
			if workspace.CurrentCamera then
				workspace.CurrentCamera.FieldOfView = v
			end
		end)
	elseif tabName == "Combat" then
		AddToggleRow(1, "Auto Dodge", "Evade nearby chasers by role", function() return State.AutoDodge end, function(v) State.AutoDodge = v end)
		AddSliderRow(2, "Dodge Range", "Threat detection radius", 5, 25, 1, " st", function() return State.DodgeRange end, function(v) State.DodgeRange = v end)
		AddSliderRow(3, "Dodge Power", "Dodge impulse velocity", 40, 150, 5, "", function() return State.DodgePower end, function(v) State.DodgePower = v end)
		AddToggleRow(4, "Anti-Stun", "Recover from stun or ragdoll", function() return State.AntiStun end, function(v) State.AntiStun = v end)
		AddToggleRow(5, "Hitbox", "Expand opponent root hitboxes", function() return State.Hitbox end, function(v) State.Hitbox = v end)
		AddSliderRow(6, "Hitbox Size", "Opponent hitbox studs", 2, 20, 1, " st", function() return State.HitboxSize end, function(v) State.HitboxSize = v end)
	elseif tabName == "Movement" then
		AddToggleRow(1, "Under Map", "Move below the map surface", function() return State.UnderMap end, SetUnderMapActive)
		AddSliderRow(2, "Under Map Depth", "Distance beneath map floor", 6, 36, 1, " st", function() return State.UnderMapDepth end, function(v)
			State.UnderMapDepth = v
			if State.UnderMap then DropUnderMap() end
		end)
		AddToggleRow(3, "Safe Floor", "Keep floor part under map", function() return State.SafeFloor end, function(v)
			State.SafeFloor = v
			if not v then DestroyUnderMapFloor() end
		end)
		AddButtonRow(4, "Snap Surface", "Return above ground immediately", "UP", function()
			SetUnderMapActive(false)
		end)
		AddToggleRow(5, "Auto Run", "Smooth forward camera movement", function() return State.AutoRun end, function(v) State.AutoRun = v end)
		AddToggleRow(6, "Speed", "Boost character walk speed", function() return State.Speed end, function(v)
			State.Speed = v
			local _, hum = GetCharacterRig()
			if hum and not v then hum.WalkSpeed = 16 end
		end)
		AddSliderRow(7, "Speed Level", "Walk speed multiplier", 1, 8, 0.5, "x", function() return State.SpeedLevel end, function(v) State.SpeedLevel = v end)
		AddSliderRow(8, "Jump Power", "Character jump force", 30, 250, 5, "", function() return State.JumpPower end, function(v)
			State.JumpPower = v
			local _, hum = GetCharacterRig()
			if hum then
				hum.UseJumpPower = true
				hum.JumpPower = v
			end
		end)
		AddToggleRow(9, "Infinite Jump", "Jump mid-air continuously", function() return State.InfiniteJump end, function(v) State.InfiniteJump = v end)
		AddToggleRow(10, "Noclip", "Pass through solid map parts", function() return State.Noclip end, function(v) State.Noclip = v end)
	end
end

