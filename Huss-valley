-- Fly
local flyBodyGyro, flyBodyVel
createToggleRow("Flight Mode", colRight, 2, function(state)
	flyEnabled = state
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	local hum = char:FindFirstChildOfClass("Humanoid")

	if flyEnabled then
		hum.PlatformStand = true

		flyBodyGyro = Instance.new("BodyGyro")
		flyBodyGyro.P = 9e4
		flyBodyGyro.maxTorque = Vector3.new(9e4, 9e4, 9e4)
		flyBodyGyro.cframe = hrp.CFrame
		flyBodyGyro.Parent = hrp

		flyBodyVel = Instance.new("BodyVelocity")
		flyBodyVel.velocity = Vector3.new(0, 0, 0)
		flyBodyVel.maxForce = Vector3.new(9e4, 9e4, 9e4)
		flyBodyVel.Parent = hrp

		RunService:BindToRenderStep("YutaFlyFixed", Enum.RenderPriority.Character.Value, function()
			if not flyEnabled or not hrp then return end
			local moveDir = hum.MoveDirection
			flyBodyVel.velocity = (camera.CFrame.LookVector * moveDir.Z + camera.CFrame.RightVector * moveDir.X) * 60
			flyBodyGyro.cframe = CFrame.new(hrp.Position, hrp.Position + Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z))
		end)
	else
		hum.PlatformStand = false
		RunService:UnbindFromRenderStep("YutaFlyFixed")
		if flyBodyGyro then flyBodyGyro:Destroy() end
		if flyBodyVel then flyBodyVel:Destroy() end
	end
end)

