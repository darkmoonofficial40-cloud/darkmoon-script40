-- Guaranteed Working ESP Logic
local function applyESPToCharacter(targetChar)
	if not targetChar then return end
	local existing = targetChar:FindFirstChild("YutaESP_Highlight")
	if not existing then
		local hl = Instance.new("Highlight")
		hl.Name = "YutaESP_Highlight"
		hl.Adornee = targetChar
		hl.FillColor = THEME_ACCENT
		hl.FillTransparency = 0.5
		hl.OutlineColor = Color3.fromRGB(255, 255, 255)
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Enabled = espEnabled
		hl.Parent = targetChar
	else
		existing.Enabled = espEnabled
	end
end

local function removeESPFromCharacter(targetChar)
	if targetChar then
		local hl = targetChar:FindFirstChild("YutaESP_Highlight")
		if hl then hl:Destroy() end
	end
end

createToggleRow("Player ESP", colLeft, 5, function(state)
	espEnabled = state
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			if p.Character then
				if espEnabled then
					applyESPToCharacter(p.Character)
				else
					removeESPFromCharacter(p.Character)
				end
			end
		end
	end
end)

-- Auto apply ESP on new player / respawn
for _, p in ipairs(Players:GetPlayers()) do
	if p ~= player then
		p.CharacterAdded:Connect(function(char)
			char:WaitForChild("HumanoidRootPart")
			if espEnabled then applyESPToCharacter(char) end
		end)
	end
end

Players.PlayerAdded:Connect(function(p)
	if p ~= player then
		p.CharacterAdded:Connect(function(char)
			char:WaitForChild("HumanoidRootPart")
			if espEnabled then applyESPToCharacter(char) end
		end)
	end
end)

