-- HELPER: UNDER MAP FLOOR & POSITIONING
--------------------------------------------------------------------
local function EnsureFloorPart()
	if not FloorPart or not FloorPart.Parent then
		local part = Instance.new("Part")
		part.Name = "BlackMoonUnderFloor"
		part.Size = Vector3.new(28, 1, 28)
		part.Anchored = true
		part.CanCollide = true
		part.Transparency = 1
		part.Parent = workspace
		FloorPart = part
	end
	return FloorPart
end

local function CleanupFloorPart()
	if FloorPart then
		FloorPart:Destroy()
		FloorPart = nil
	end
end

local function DropUnderMap()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char, FloorPart }

	local downRay = workspace:Raycast(root.Position + Vector3.new(0, 4, 0), Vector3.new(0, -120, 0), rayParams)
	local targetY = downRay and (downRay.Position.Y - UnderMapDepth) or (root.Position.Y - UnderMapDepth)

	root.CFrame = CFrame.new(root.Position.X, targetY, root.Position.Z)
	if UnderMapSafeFloor then
		local floor = EnsureFloorPart()
		floor.CFrame = CFrame.new(root.Position.X, targetY - 3.5, root.Position.Z)
	end
end

local function RiseToSurface()
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then return end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { char, FloorPart }

	local upRay = workspace:Raycast(root.Position, Vector3.new(0, 160, 0), rayParams)
	if upRay then
		root.CFrame = CFrame.new(root.Position.X, upRay.Position.Y + 4, root.Position.Z)
	else
		root.CFrame = root.CFrame + Vector3.new(0, UnderMapDepth + 4, 0)
	end
	CleanupFloorPart()
end

