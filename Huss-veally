-- 6. UNIFIED FRAME LOOP & THROTTLED BACKGROUND TASKS
--------------------------------------------------------------------
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hum or not root then return end

	if SpeedEnabled then
		local desiredSpeed = 16 * SpeedMultiplier
		if hum.WalkSpeed ~= desiredSpeed then
			hum.WalkSpeed = desiredSpeed
		end
	elseif hum.WalkSpeed > 16 and hum.WalkSpeed <= 128 then
		hum.WalkSpeed = 16
	end

	if AutoRunEnabled then
		local cam = workspace.CurrentCamera
		local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		if flatLook.Magnitude > 0 then
			currentMoveVector = currentMoveVector:Lerp(flatLook.Unit, 0.2)
			hum:Move(currentMoveVector, true)
		end
	end

	if IsInvisible then
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
				desc.Transparency = 1
				desc.LocalTransparencyModifier = 1
			elseif desc:IsA("Decal") or desc:IsA("Texture") then
				desc.Transparency = 1
			elseif desc:IsA("Accessory") then
				local handle = desc:FindFirstChild("Handle")
				if handle then
					handle.Transparency = 1
					handle.LocalTransparencyModifier = 1
				end
			end
		end
	end

	if UnderMapEnabled and UnderMapSafeFloor and FloorPart then
		FloorPart.CFrame = CFrame.new(root.Position.X, root.Position.Y - 3.5, root.Position.Z)
	end

	if AutoDodgeEnabled and (tick() - LastDodgeTime > 0.4) then
		for _, otherPlr in ipairs(Players:GetPlayers()) do
			local otherRoot = IsEnemyPlayer(LocalPlayer, otherPlr) and otherPlr.Character and otherPlr.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot then
				local dist = (root.Position - otherRoot.Position).Magnitude
				if dist <= DodgeDistance then
					LastDodgeTime = tick()
					local away = (root.Position - otherRoot.Position)
					local flatAway = Vector3.new(away.X, 0, away.Z)
					local dodgeDir = (flatAway.Magnitude > 0 and flatAway.Unit or -root.CFrame.LookVector)
					dodgeDir = Vector3.new(dodgeDir.X, 0.25, dodgeDir.Z).Unit
					root.AssemblyLinearVelocity = dodgeDir * DodgePower
					hum:ChangeState(Enum.HumanoidStateType.Freefall)
					break
				end
			end
		end
	end
end)

RunService.Stepped:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	if NoclipLoop or UnderMapEnabled then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end)

-- Throttled loops for ESP, Hitboxes, Anti-Stun, and Teleport Loop
task.spawn(function()
	while true do
		task.wait(0.25)

		if AntiStunEnabled then
			local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if hum and (hum.PlatformStand or hum:GetState() == Enum.HumanoidStateType.Ragdoll) then
				hum.PlatformStand = false
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end

		if TeleportLoop and SelectedPlayer ~= "" and SelectedPlayer ~= "Select a Player" then
			local targetRoot = Players:FindFirstChild(SelectedPlayer) and Players[SelectedPlayer].Character and Players[SelectedPlayer].Character:FindFirstChild("HumanoidRootPart")
			local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if targetRoot and myRoot then
				myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
			end
		end

		if HitboxExpanderEnabled then
			for _, plr in ipairs(Players:GetPlayers()) do
				local hrp = plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
					hrp.Transparency = 0.7
					hrp.BrickColor = BrickColor.new("Bright red")
					hrp.CanCollide = false
				end
			end
		end

		if ESPEnabled then
			for _, plr in ipairs(Players:GetPlayers()) do
				local tChar = plr ~= LocalPlayer and plr.Character
				if tChar and tChar:FindFirstChild("HumanoidRootPart") and not tChar:FindFirstChild("BlackMoonESP") then
					local highlight = Instance.new("Highlight")
					highlight.Name = "BlackMoonESP"
					highlight.FillColor = Color3.fromRGB(255, 0, 0)
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.FillTransparency = 0.5
					highlight.Parent = tChar
				end
			end
		end
	end
end)

