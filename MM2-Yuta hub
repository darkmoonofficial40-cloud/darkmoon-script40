			local cullOn = false
			local culledParts = {}
			local cullLoop

			local function isPlayerPart(p)
				for _, plr in ipairs(Players:GetPlayers()) do
					if plr.Character and p:IsDescendantOf(plr.Character) then return true end
				end
				return false
			end

			local function runCull()
				local cam = workspace.CurrentCamera
				if not cam then return end
				local camPos = cam.CFrame.Position
				local maxDistSq = 220 * 220

				for _, p in ipairs(workspace:GetDescendants()) do
					if p:IsA("BasePart") and not isPlayerPart(p) and p.Transparency < 1 then
						local distSq = (p.Position.X - camPos.X)^2 + (p.Position.Y - camPos.Y)^2 + (p.Position.Z - camPos.Z)^2
						if distSq > maxDistSq then
							if culledParts[p] == nil then
								culledParts[p] = p.LocalTransparencyModifier
							end
							p.LocalTransparencyModifier = 1
						elseif culledParts[p] ~= nil then
							p.LocalTransparencyModifier = culledParts[p]
							culledParts[p] = nil
						end
					end
				end
			end

			local function enableCulling()
				cullOn = true
				cullLoop = task.spawn(function()
					while cullOn do
						pcall(runCull)
						task.wait(0.35)
					end
				end)
			end

			local function disableCulling()
				cullOn = false
				if cullLoop then
					pcall(task.cancel, cullLoop)
					cullLoop = nil
				end
				for p, mod in pairs(culledParts) do
					if p and p.Parent then
						pcall(function() p.LocalTransparencyModifier = mod end)
					end
				end
				table.clear(culledParts)
			end

			
