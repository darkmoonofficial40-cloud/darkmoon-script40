							LightInfluence = 0,
							MinLength = 0.05,
							Lifetime = backtrack.delay / 1000,
							Parent = hrp,
						})
						table.insert(d.extra, a0)
						table.insert(d.extra, a1)
						table.insert(d.extra, tr)
						return tr
					end

					if hrp then
						d.trail = trail(2.1, -2.8, 0.35)
						d.core = trail(0.12, -0.12, 1)
					end
