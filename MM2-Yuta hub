				local lead = silentAim.auto and math.clamp(getPing() / 2000 + 0.1, 0, 0.45) or (silentAim.pred / 1000)
				local aimPos = target.Position + Vector3.new(v.X, v.Y * 0.5, v.Z) * lead

				local blockedByInnocent, innocentPlr = isInnocentInWay(muzzle, aimPos, murdererChar)
				if blockedByInnocent then
					if source ~= "AutoShoot" then
						notify("Shoot Murderer", "shot blocked: " .. (innocentPlr and (innocentPlr.DisplayName or innocentPlr.Name) or "innocent") .. " in the way!")
					end
					if not wasEquipped then
						task.delay(0.12, function()
							if hum and hum.Parent then
								pcall(hum.UnequipTools, hum)
