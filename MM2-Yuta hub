		local function closeDropdown()
			if not isOpen then return end
			isOpen = false
			tween(chevron, 0.18, { Rotation = 0 })
			tween(c1, 0.18, { BackgroundColor3 = dimColor })
			tween(c2, 0.18, { BackgroundColor3 = dimColor })
			tween(badgeStroke, 0.2, { Color = strokeColor })
			if dropContainer then
				pcall(function() dropContainer:Destroy() end)
				dropContainer = nil
			end
			if backdrop then
				pcall(function() backdrop:Destroy() end)
				backdrop = nil
			end
			if activeDropdownClose == closeDropdown then
				activeDropdownClose = nil
			end
		end

		local function choose(i, silent)
			cur = i
			lbl.Text = options[cur] or ""
			badgeStroke.Color = accentColor
			tween(badgeStroke, 0.35, { Color = strokeColor })
			setConfig(key, options[cur])
			if not silent and callback then
				task.spawn(callback, options[cur])
			end
		end

		local function openDropdown()
			if isOpen then
				closeDropdown()
				return
			end
			if activeDropdownClose then
				activeDropdownClose()
			end
			isOpen = true
			activeDropdownClose = closeDropdown

