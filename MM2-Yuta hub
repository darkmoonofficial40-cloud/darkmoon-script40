				tween(c1, 0.15, { BackgroundColor3 = dimColor })
				tween(c2, 0.15, { BackgroundColor3 = dimColor })
			end
		end)

		return {
			Set = function(opt, silent)
				local i = table.find(options, opt)
				if i then
					choose(i, silent)
				end
			end,
			Get = function()
