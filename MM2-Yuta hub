local function selectTab(tab)
	if activeDropdownClose then
		pcall(activeDropdownClose)
	end
	if currentTab == tab then
		return
	end
	local old = currentTab
	currentTab = tab
	for _, t in ipairs(tabs) do
		if t ~= tab then
			t.page.Visible = false
		end
	end
	local y = getTabY(tab)
	if old then
		tween(tabSelector, 0.25, { Position = UDim2.fromOffset(8, y) }, Enum.EasingDirection.Out, Enum.EasingStyle.Quint)
	else
		tabSelector.Position = UDim2.fromOffset(8, y)
	end
