local function resolveCustomAsset(filename)
	local gca = getcustomasset or getsynasset
	local chk = isfile
	if not gca then return nil end

	if SolidColorBase64[filename] and writefile and chk and not chk(filename) and not chk("skies/" .. filename) and not chk("downloaded_skies/" .. filename) then
		pcall(function()
			if makefolder and not (isfolder and (isfolder("skies") or isfolder("downloaded_skies"))) then
				pcall(makefolder, "skies")
			end
			local dec = crypt and crypt.base64decode or base64_decode or syn and syn.crypt and syn.crypt.base64.decode
			if dec then
				local dir = (isfolder and isfolder("skies")) and "skies/" or (isfolder and isfolder("downloaded_skies") and "downloaded_skies/" or "skies/")
				writefile(dir .. filename, dec(SolidColorBase64[filename]))
			end
		end)
	end

	if CustomCursorBase64[filename] and writefile and chk and not chk(filename) and not chk("downloaded_assets/cursors/" .. filename) then
		pcall(function()
			if makefolder then
				if not (isfolder and isfolder("downloaded_assets")) then pcall(makefolder, "downloaded_assets") end
				if not (isfolder and isfolder("downloaded_assets/cursors")) then pcall(makefolder, "downloaded_assets/cursors") end
			end
			local dec = crypt and crypt.base64decode or base64_decode or syn and syn.crypt and syn.crypt.base64.decode
			if dec then
				writefile("downloaded_assets/cursors/" .. filename, dec(CustomCursorBase64[filename]))
			end
		end)
	end

	if (filename == "nobackroundkynox.png" or filename == "kynox.png") and writefile and chk and not chk(filename) and not chk("kynox/" .. filename) then
		pcall(function()
			local ok, res = pcall(function()
				return game:HttpGet("https://git.sqmon.org/lua-slop.git/plain/" .. filename)
			end)
			if ok and type(res) == "string" and #res > 0 and not res:match("^%s*<!DOCTYPE") and not res:match("^%s*<html") then
				writefile(filename, res)
			end
		end)
	end

	if not chk then return nil end
	local paths = {
		filename,
		"kynox/" .. filename,
		"sqmon/" .. filename,
		"mm2/" .. filename,
		"downloaded_assets/cursors/" .. filename,
		"cursors/" .. filename,
		"skies/" .. filename,
		"downloaded_skies/" .. filename,
		"downloaded_assets/" .. filename,
		"kynox/skies/" .. filename,
		"kynox/downloaded_assets/cursors/" .. filename,
		"kynox/downloaded_skies/" .. filename,
		"kynox/downloaded_assets/" .. filename,
		"sqmon/skies/" .. filename,
		"sqmon/downloaded_assets/cursors/" .. filename,
		"sqmon/downloaded_skies/" .. filename,
		"sqmon/downloaded_assets/" .. filename,
		"mm2/skies/" .. filename,
		"mm2/downloaded_skies/" .. filename,
		"mm2/downloaded_assets/" .. filename,
	}
	for _, p in ipairs(paths) do
		local ok, exists = pcall(chk, p)
		if ok and exists then
			local ok2, asset = pcall(gca, p)
			if ok2 and asset then
				return asset
			end
		end
	end
	return nil
end

local function getAssetUri(assetId)
	local idStr = tostring(assetId):match("%d+") or tostring(assetId)
	local fn = LocalAssetFiles[idStr]
	if fn then
		local custom = resolveCustomAsset(fn)
		if custom then
			return custom
		end
	end
	return "rbxassetid://" .. idStr
end

local function loadObjects(assetId)
	local idStr = tostring(assetId):match("%d+") or tostring(assetId)
	local fn = LocalAssetFiles[idStr]
	if fn then
		local custom = resolveCustomAsset(fn)
		if custom then
			local ok, objs = pcall(game.GetObjects, game, custom)
			if ok and objs and #objs > 0 then
				return objs
			end
		end
	end
	return game:GetObjects("rbxassetid://" .. idStr)
end

