						applyDecalHide(inst)
					end
				end
				noTexConn = workspace.DescendantAdded:Connect(function(inst)
					if not noTexturesOn then return end
					if inst:IsA("BasePart") then
						task.defer(applyPartSmooth, inst)
					elseif inst:IsA("Decal") or inst:IsA("Texture") then
						task.defer(applyDecalHide, inst)
					end
				end)
