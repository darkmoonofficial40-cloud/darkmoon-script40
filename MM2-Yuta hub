				local function checkCrosshairTarget()
					local cam = workspace.CurrentCamera
					local mRay = mouseRay(cam)
					trigFilter()

					local offsets = {
						Vector3.zero,
						cam.CFrame.RightVector * 0.45,
						-cam.CFrame.RightVector * 0.45,
						cam.CFrame.UpVector * 0.45,
						-cam.CFrame.UpVector * 0.45,
					}

					local foundMurderer = nil
					local sawInnocent = false

					for _, off in ipairs(offsets) do
						local hit = workspace:Raycast(mRay.Origin + off, mRay.Direction * 1000, trigRp)
						if hit and hit.Instance then
							local hitPlr, hitChar = getPlayerFromHit(hit.Instance)
							if hitPlr and hitPlr ~= player then
								local hitHum = hitChar:FindFirstChildOfClass("Humanoid")
								local hitRoot = hitChar:FindFirstChild("HumanoidRootPart")
								if hitHum and hitHum.Health > 0 and hitRoot and not inLobby(hitRoot.Position) then
									if isTargetMurderer(hitPlr, hitChar) then
										foundMurderer = hitRoot
									else
										sawInnocent = true
									end
								end
							end
						end
					end

					return foundMurderer, sawInnocent
				end

				local function step(dt)
					local now = os.clock()
					local assistActive = cfg.assistOn and (cfg.assistMode == "Always" or (cfg.assistMode == "Hold" and assistKeyDown) or (cfg.assistMode == "Toggle" and assistToggleState))
					local fbActive = fb.state ~= "idle"
					local triggerActive = cfg.triggerOn and (cfg.triggerMode == "Always" or (cfg.triggerMode == "Hold" and triggerKeyDown) or (cfg.triggerMode == "Toggle" and triggerToggleState))

					if not assistActive and not fbActive and not triggerActive then
						if fovRing.Visible then
							fovRing.Visible = false
						end
						return
					end

					local cam = workspace.CurrentCamera
					local char = player.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local holdingGun = char and char:FindFirstChild("Gun") ~= nil
					local holdingKnife = char and char:FindFirstChild("Knife") ~= nil
					local canAssist = holdingGun or holdingKnife or cfg.assistWithoutGun

					if assistActive and cfg.assistCircle and canAssist and not (hum and hum.Health <= 0) then
						local mpt
						if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
							mpt = cam.ViewportSize / 2
						else
							mpt = UserInputService:GetMouseLocation()
						end
						fovRing.Size = UDim2.fromOffset(cfg.assistFov * 2, cfg.assistFov * 2)
						fovRing.Position = UDim2.fromOffset(mpt.X, mpt.Y)
						fovRing.Visible = true
					else
						fovRing.Visible = false
					end

					if fb.state ~= "idle" then
						if not hum or hum.Health <= 0 or cam.CameraType == Enum.CameraType.Scriptable then
							release()
							return
						end
						local root = fb.root
						local alive = root and root.Parent and holdingGun
						if fb.state == "forward" then
							if not alive then
								beginReturn()
								return
							end
							local st = fb.stroke
							local remaining = math.max(0, st.t0 + st.T1 + st.T2 - now)
							local P, _, selfShift = solve(root, remaining, fb.offset)
							local ty, tp = pointAngles(cam, steerPoint(P, selfShift))
							local y, p, done = strokeAngles(st, ty, tp)
							setAngles(cam, y, p)
							if done or st.T1 <= 0.002 then
								fb.state = "aim"
								fb.aimUntil = now + (cfg.flickMin <= 20 and 0.28 or gauss(0.14, 0.03, 0.08, 0.25))
							end
						elseif fb.state == "aim" then
							if not alive then
								beginReturn()
								return
							end
							local P, shift = track2(cam, root, dt, 35)
							local chance, clear = evaluate(root, shift, P)
							local fastFlick = cfg.flickMin <= 30
							local canHit = (clear or not cfg.triggerMuzzle) and (chance * 100 >= math.min(cfg.minHit, 30) or fastFlick)
							local _, innoInCrosshair = checkCrosshairTarget()
							local safeToShoot = not innoInCrosshair or cfg.triggerInno
							if safeToShoot and canHit and now - lastShot > shotCooldown and fire() then
								fb.state = "hold"
								fb.holdFrames = math.random(1, 2)
							elseif now > fb.aimUntil then
								beginReturn()
							end
						elseif fb.state == "hold" then
							if alive then
								track2(cam, root, dt, 35)
							end
							fb.holdFrames -= 1
							if fb.holdFrames <= 0 then
								beginReturn()
							end
						elseif fb.state == "return" then
							local y, p, done = strokeAngles(fb.stroke, fb.ry, fb.rp)
							setAngles(cam, y, p)
							if done or fb.stroke.T1 <= 0.002 then
								release()
							end
						end
						return
					end

					if assistActive and canAssist and hum and hum.Health > 0 and cam.CameraType ~= Enum.CameraType.Scriptable and not busy and not nativeBusy then
						local isRage = cfg.assistType == "Rage"
						local mr = getTarget(true)
						if mr and mr.Parent then
							sample(mr, now)

							if mr ~= assistActiveTarget then
								assistActiveTarget = mr
								if cfg.assistReaction > 0 then
									local rSec = math.max(0.02, cfg.assistReaction / 1000)
									assistJukeUntil = math.max(assistJukeUntil, now + gauss(rSec * 0.65, rSec * 0.18, rSec * 0.35, rSec * 1.15))
								else
									assistJukeUntil = 0
								end
								if not isRage then
									assistCurrentOffset = Vector3.new(0, 0.2, 0)
									assistTargetOffset = Vector3.new((math.random() - 0.5) * 0.4, 0.2 + (math.random() - 0.5) * 0.35, 0)
									assistNextSpotSwitch = now + 0.35 + math.random() * 0.45
								end
							end

							local effectiveOffset
							if isRage then
								local head = mr.Parent:FindFirstChild("Head")
								if head and head:IsA("BasePart") then
									effectiveOffset = head.Position - mr.Position
								else
									effectiveOffset = Vector3.new(0, 0.8, 0)
								end
							else
								if cfg.assistDynamicSpot then
									if now >= assistNextSpotSwitch then
										assistNextSpotSwitch = now + 0.4 + math.random() * 0.65
										local candidateSpots = {
											Vector3.new(0, 0.75, 0),
											Vector3.new(-0.35, 0.25, 0),
											Vector3.new(0.35, 0.25, 0),
											Vector3.new(0, 0.15, 0),
											Vector3.new(0.15, -0.25, 0),
											Vector3.new(-0.15, -0.25, 0),
										}
										local chosen = candidateSpots[math.random(1, #candidateSpots)]
										assistTargetOffset = chosen + Vector3.new((math.random() - 0.5) * 0.18, (math.random() - 0.5) * 0.2, (math.random() - 0.5) * 0.12)
									end
									local transK = 1 - math.exp(-dt * 3.4)
									assistCurrentOffset = assistCurrentOffset:Lerp(assistTargetOffset, transK)
								else
									assistCurrentOffset = Vector3.zero
								end

								local microDrift = cfg.assistDynamicSpot and Vector3.new(
									math.sin(now * 1.85 + mr.Position.X * 0.1) * 0.12,
									math.cos(now * 1.45 + mr.Position.Y * 0.1) * 0.15,
									0
								) or Vector3.zero

								effectiveOffset = assistCurrentOffset + microDrift
							end

							local P, _, selfShift = solve(mr, 0, effectiveOffset)
							local sp, inView = cam:WorldToViewportPoint(P)
							if inView and sp.Z > 0 then
								local locked = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
								local mpt = locked and (cam.ViewportSize / 2) or UserInputService:GetMouseLocation()
								local sTarget = Vector2.new(sp.X, sp.Y)
								local sDelta = sTarget - mpt
								local dist = sDelta.Magnitude
								if (isRage or dist <= cfg.assistFov) and (not (cfg.assistWallCheck ~= false) or not worldRay(cam.CFrame.Position, P - cam.CFrame.Position)) then
									local mDelta = UserInputService:GetMouseDelta()
									local cy, cp = currentAngles(cam)

									local camPos = cam.CFrame.Position
									local dist3D = (P - camPos).Magnitude
									local distFactor = cfg.assistDistanceDecay and math.clamp((dist3D - 25) / 75, 0, 2.8) or 0

									local charModel = mr.Parent
									local headPart = charModel and charModel:FindFirstChild("Head")
									local headY = headPart and headPart.Position.Y or (mr.Position.Y + 2.0)
									local feetY = mr.Position.Y - 2.8
									local spHead = cam:WorldToViewportPoint(Vector3.new(mr.Position.X, headY, mr.Position.Z))
									local spFeet = cam:WorldToViewportPoint(Vector3.new(mr.Position.X, feetY, mr.Position.Z))
									local screenHeight = math.max(4, math.abs(spFeet.Y - spHead.Y))
									local sizeDifficulty = cfg.assistDistanceDecay and math.clamp(55 / screenHeight, 0.6, 3.2) or 1.0

									local pullDecay = 1 / (1 + distFactor * 1.45 * (sizeDifficulty ^ 0.55))

									local tVel = mr.AssemblyLinearVelocity or Vector3.zero
									local lagTime = cfg.assistDistanceDecay and math.clamp(0.035 + distFactor * 0.075, 0, 0.26) or 0
									local trackingLagOffset = -tVel * lagTime

									local struggleNoiseY, struggleNoiseP = 0, 0
									if cfg.assistDistanceDecay and distFactor > 0.05 then
										local struggleAmp = math.rad(0.02 + distFactor * 0.085 * (sizeDifficulty / 1.4))
										struggleNoiseY = math.sin(now * 3.1 + mr.Position.X) * struggleAmp + math.cos(now * 5.2) * (struggleAmp * 0.45)
										struggleNoiseP = math.cos(now * 2.7 + mr.Position.Z) * struggleAmp + math.sin(now * 4.4) * (struggleAmp * 0.45)
									end

									local slipMultiplier = 1.0
									if cfg.assistDistanceDecay and distFactor > 0.35 then
										local slipWave = math.sin(now * 1.35 + dist3D * 0.12)
										if slipWave > 0.72 then
											slipMultiplier = math.max(0.25, 1 - distFactor * 0.32)
										end
									end

									local steerTarget = steerPoint(P + trackingLagOffset, selfShift)
									local ty, tp = pointAngles(cam, steerTarget)
									local dy, dp = wrap(ty - cy + struggleNoiseY), tp - cp + struggleNoiseP

									local opposes = false
									if not isRage then
										if locked or not cfg.assistMouseMode or not (mousemoveabs or mousemoverel) then
											opposes = mDelta.Magnitude > 8 and (mDelta.X * dy + mDelta.Y * dp) < -0.4 * mDelta.Magnitude * math.sqrt(dy * dy + dp * dp)
										else
											opposes = mDelta.Magnitude > 8 and (mDelta.X * sDelta.X + mDelta.Y * sDelta.Y) < -0.4 * mDelta.Magnitude * dist
										end
									end

									if not opposes then
										local s = track[mr]
										if cfg.assistReaction > 0 and s and s.a.Magnitude > 28 and now > assistJukeUntil then
											assistJukeUntil = now + gauss(cfg.assistReaction / 1000, 0.04, 0.16, 0.42)
										end
										if cfg.assistReaction <= 0 or now > assistJukeUntil then
											local friction = (dist < 32 and cfg.assistFriction) and 0.55 or 1.0
											local k
											if cfg.assistSmooth <= 0 then
												k = 1
											else
												local rate = isRage and (35 / math.max(cfg.assistSmooth, 0.5) * friction) or (cfg.assistSmooth * 2.2 * friction * pullDecay * slipMultiplier)
												k = 1 - math.exp(-dt * rate)
											end

											local ny, np = 0, 0
											if cfg.assistJitter then
												ny, np = tremor(now, math.rad(0.035 * (1 + distFactor * 0.5)))
											end

											if not locked and cfg.assistMouseMode and (mousemoveabs or mousemoverel) then
												local screenNoiseX = (cfg.assistDistanceDecay and distFactor > 0) and (math.sin(now * 3.4) * (distFactor * 2.2 * sizeDifficulty)) or 0
												local screenNoiseY = (cfg.assistDistanceDecay and distFactor > 0) and (math.cos(now * 2.9) * (distFactor * 2.2 * sizeDifficulty)) or 0
												local myJitterX, myJitterY = 0, 0
												if cfg.assistJitter then
													myJitterX, myJitterY = tremor(now, 1.2 * (1 + distFactor * 0.4))
												end
												local pullX = (sDelta.X + screenNoiseX) * k + myJitterX
												local pullY = (sDelta.Y + screenNoiseY) * k + myJitterY
												if mousemoveabs then
													mousemoveabs(mpt.X + pullX, mpt.Y + pullY)
												else
													mousemoverel(pullX, pullY)
												end
											else
												setAngles(cam, cy + dy * k + ny, cp + dp * k + np)
											end
										end
									end
								end
							end
						end
					end

					local triggerActive = cfg.triggerOn and (cfg.triggerMode == "Always" or (cfg.triggerMode == "Hold" and triggerKeyDown) or (cfg.triggerMode == "Toggle" and triggerToggleState))
					if triggerActive and hum and hum.Health > 0 and not busy and not nativeBusy then
						if not holdingGun and cfg.triggerAutoEquip then
							equipGun()
							holdingGun = char:FindFirstChild("Gun") ~= nil
						end

						local canShoot = (now - lastShot > shotCooldown)

						local detectedTarget = nil
						local isDirectHit = false

						local directMurderer, hitInnocent = checkCrosshairTarget()

						if hitInnocent and not cfg.triggerInno then
							detectedTarget = nil
							triggerArmed = false
							triggerTargetTime = nil
						elseif directMurderer then
							detectedTarget = directMurderer
							isDirectHit = true
						elseif cfg.triggerInno and hitInnocent then
							local mRay = mouseRay(cam)
							trigFilter()
							local trigHit = workspace:Raycast(mRay.Origin, mRay.Direction * 1000, trigRp)
							local hitPlr, hitChar = getPlayerFromHit(trigHit and trigHit.Instance)
							if hitChar then
								detectedTarget = hitChar:FindFirstChild("HumanoidRootPart")
								isDirectHit = true
							end
						end

						if not detectedTarget and not hitInnocent and cfg.triggerMinHit < 100 then
							local _, mr = getMurderer()
							if not mr and cfg.triggerInno then
								mr = getTarget(true)
							end
							if mr and mr.Parent then
								local P, shift = solve(mr, 0, Vector3.zero)
								local chance, clear = evaluate(mr, shift, P)
								local validClear = not cfg.triggerMuzzle or clear
								if validClear and chance * 100 >= cfg.triggerMinHit then
									local innoInWay = false
									local M = getMuzzlePos()
									if M and not cfg.triggerInno then
										local dir = (mouseHit(cam) - M).Unit
										local leadRay = workspace:Raycast(M, dir * 1000, trigRp)
										if leadRay and leadRay.Instance then
											local lPlr, lChar = getPlayerFromHit(leadRay.Instance)
											if lPlr and lPlr ~= player and not isTargetMurderer(lPlr, lChar) then
												innoInWay = true
											end
										end
									end
									if not innoInWay then
										detectedTarget = mr
										isDirectHit = false
									end
								end
							end
						end

						if detectedTarget and holdingGun then
							local delayMs = cfg.triggerDelay
							if cfg.triggerVariance > 0 then
								delayMs = delayMs + math.random() * cfg.triggerVariance
							end
							local roll = delayMs / 1000

							if roll <= 0.003 or cfg.triggerLatch then
								if canShoot then
									triggerArmed = false
									triggerTargetTime = nil
									fire()
								else
									triggerArmed = true
									triggerTargetTime = lastShot + shotCooldown
									triggerArmedExpires = triggerTargetTime + 0.12
								end
							else
								if not triggerArmed then
									triggerArmed = true
									triggerTargetTime = now + roll
									triggerArmedExpires = now + roll + 0.15
								end
							end
						end

						if triggerArmed and triggerTargetTime and now >= triggerTargetTime then
							triggerArmed = false
							triggerTargetTime = nil
							if holdingGun and (now - lastShot > shotCooldown) then
									local _, innoInAim = checkCrosshairTarget()
								if not innoInAim or cfg.triggerInno then
									fire()
								end
							end
						elseif triggerArmed and triggerArmedExpires and now > triggerArmedExpires then
							triggerArmed = false
							triggerTargetTime = nil
						end
					else
						triggerArmed = false
						triggerTargetTime = nil
					end
				end

				pcall(function()
					RunService:UnbindFromRenderStep("kynoxFlickbot")
				end)
				RunService:BindToRenderStep("kynoxFlickbot", Enum.RenderPriority.Camera.Value + 1, step)
				table.insert(connections, {
					Disconnect = function()
						pcall(function()
							RunService:UnbindFromRenderStep("kynoxFlickbot")
						end)
						pcall(function()
							fovGui:Destroy()
						end)
					end,
				})

				local function matchesInput(input, boundKey)
					if not boundKey then
						return false
					end
					if typeof(boundKey) == "EnumItem" then
						if boundKey.EnumType == Enum.KeyCode then
							return input.KeyCode == boundKey
						elseif boundKey.EnumType == Enum.UserInputType then
							return input.UserInputType == boundKey
						end
					end
					return false
				end

				connect(UserInputService.InputBegan, function(input, gp)
					if UserInputService:GetFocusedTextBox() then
						return
					end
					if matchesInput(input, cfg.assistInnoKey) then
						assistInnoToggled = not assistInnoToggled
						notify("Aim Assist", assistInnoToggled and "Targeting all players" or "Targeting murderer only")
					end
					if matchesInput(input, cfg.assistKey) then
						if cfg.assistMode == "Hold" then
							assistKeyDown = true
						elseif cfg.assistMode == "Toggle" then
							assistToggleState = not assistToggleState
						end
					end
					if cfg.flickOn and matchesInput(input, cfg.flickKey) then
						local target = getFlickTarget()
						if target then
							task.spawn(startFlick, target)
						else
							notify("Flickbot", "no target found")
						end
					end
					if matchesInput(input, cfg.triggerKey) then
						if cfg.triggerMode == "Hold" then
							triggerKeyDown = true
						elseif cfg.triggerMode == "Toggle" then
							triggerToggleState = not triggerToggleState
						end
					end
				end)

				connect(UserInputService.InputEnded, function(input)
					if matchesInput(input, cfg.assistKey) then
						assistKeyDown = false
					end
					if matchesInput(input, cfg.triggerKey) then
						triggerKeyDown = false
					end
				end)

				local seenSince, reactNeed = nil, 0
				connect(RunService.Heartbeat, function()
					if not cfg.flickOn or cfg.flickTrigger ~= "Auto" or fb.state ~= "idle" then
						seenSince = nil
						return
					end
					local char = player.Character
					local myRoot = char and char:FindFirstChild("HumanoidRootPart")
					if not myRoot or not findTool(player, "Gun") or inLobby(myRoot.Position) then
						seenSince = nil
						return
					end
					local _, mr = getMurderer()
					if not mr then
						seenSince = nil
						return
					end
					local eye = myRoot.Position + Vector3.new(0, 1.5, 0)
					local d = mr.Position - eye
					if d.Magnitude > cfg.autoRange or worldRay(eye, d) then
						seenSince = nil
						return
					end
					local now = os.clock()
					if not seenSince then
						seenSince = now
						local rBase = (cfg.flickReaction or 50) / 1000
						reactNeed = rBase <= 0.005 and 0 or (rBase * gauss(1, 0.08, 0.85, 1.15))
					end
					local minFlickInterval = (cfg.flickMin <= 15) and 0.45 or 1.0
					if (now - seenSince >= reactNeed or reactNeed <= 0) and now - lastFlick > minFlickInterval and now - lastShot > shotCooldown then
						seenSince = nil
						task.spawn(startFlick, mr)
					end
				end)

