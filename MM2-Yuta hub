				Size = UDim2.new(1, -140, 0, 13),
				Parent = row,
			})
		end
		local hovered, active = false, false

		local function refresh()
			local lit = hovered or active
			tween(row, 0.12, { BackgroundColor3 = hovered and hoverColor or elemColor })
			logo2.TextColor3 = lit and accentColor or textColor
			rowStroke.Color = active and activeStroke or (hovered and hoverStroke or strokeColor)
		end

		connect(row.MouseEnter, function()
			hovered = true
			refresh()
		end)
		connect(row.MouseLeave, function()
			hovered = false
			refresh()
		end)

		local function highlight(on)
			active = on
			refresh()
		end

		return row, logo2, rowStroke, highlight
	end

	Section.Toggle = function(self2, name, desc, callback)
		if type(desc) == "function" then
			callback = desc
			desc = nil
		end
		local state = false
		local key = configKey(self2, name)
		local row, _, _, highlight = self2:_row(name, desc)
		local track = create("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(32, 16),
			BackgroundColor3 = bgColor,
			BorderSizePixel = 0,
			Parent = row,
		})
		makeRound(track)
		local knob = create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 8, 0.5, 0),
			Size = UDim2.fromOffset(10, 10),
