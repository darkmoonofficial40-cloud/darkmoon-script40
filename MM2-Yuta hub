					local a, b = slab(lo.X, ld.X, half.X, 0, math.huge)
					if not a then
						return nil
					end
					a, b = slab(lo.Y, ld.Y, half.Y, a, b)
					if not a then
						return nil
					end
					a = slab(lo.Z, ld.Z, half.Z, a, b)
					return a
				end

				local disk = {}
				for i = 0, 47 do
					local r = math.sqrt((i + 0.5) / 48)
					local th = i * 2.399963
					disk[i + 1] = Vector2.new(r * math.cos(th), r * math.sin(th))
				end

				local function spreadDeg(myRoot)
					local v = myRoot.AssemblyLinearVelocity
					local speed = Vector3.new(v.X, 0, v.Z).Magnitude
					return cfg.spreadBase + cfg.spreadMove * math.clamp(speed / 16, 0, 1.5) + (isAir(myRoot.Parent) and cfg.spreadAir or 0)
				end

				local function hitChance(origin, dir, boxes, deg, maxDist)
					local tn = math.tan(math.rad(deg))
					local right = dir:Cross(Vector3.yAxis)
					if right.Magnitude < 1e-3 then
						right = Vector3.xAxis
					end
					right = right.Unit
					local up = right:Cross(dir).Unit
					local spread = deg > 0.01
					local n = spread and #disk or 1
					local hits = 0
					for i = 1, n do
						local s = spread and disk[i] or Vector2.zero
						local d = (dir + (right * s.X + up * s.Y) * tn).Unit
						for _, b in ipairs(boxes) do
							local t = rayBox(origin, d, b[1], b[2])
							if t and t <= maxDist then
								hits += 1
								break
							end
						end
					end
					return hits / n
				end

				local function mouseRay(cam)
					local pt
					if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
						pt = cam.ViewportSize / 2
					else
						pt = UserInputService:GetMouseLocation()
					end
					return cam:ViewportPointToRay(pt.X, pt.Y)
				end

				local function mouseHit(cam)
					local ray = mouseRay(cam)
					local list = { cam }
					if player.Character then
						table.insert(list, player.Character)
					end
					for _, x in ipairs(CS:GetTagged("WeaponPassthrough")) do
						table.insert(list, x)
					end
					mp.FilterDescendantsInstances = list
					local r = workspace:Raycast(ray.Origin, ray.Direction * 1000, mp)
					return r and r.Position or (ray.Origin + ray.Direction * 1000)
				end

				local function getMuzzlePos()
					local char = player.Character
					local myRoot = char and char:FindFirstChild("HumanoidRootPart")
					if not myRoot then
						return nil
					end
					local gun = char:FindFirstChild("Gun")
					local handle = gun and gun:FindFirstChild("Handle")
					return muzzlePos(handle and handle.Position or myRoot.Position), myRoot
				end

				local function aimPart(char)
					if silentAim.part == "Head" then
						return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
					end
					return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
				end

				local function solve(root, tFire, offset)
					local part = aimPart(root.Parent) or root
					local t = tFire + leadTime()
					local shift = predictRoot(root, t) - root.Position
					local _, myRoot = getMuzzlePos()
					local selfShift = myRoot and predictSelf(myRoot, tFire) or Vector3.zero
					return (part.CFrame + shift) * (offset or Vector3.zero), shift, selfShift
				end

				local function steerPoint(P, selfShift)
					local M = getMuzzlePos()
					if not M then
						return P
					end
					M += selfShift or Vector3.zero
					local d = P - M
					if d.Magnitude < 0.5 then
						return P
					end
					local u = d.Unit
					local hit = worldRay(P, u * 300)
					return hit and hit.Position or (P + u * 300)
				end

				local function evaluate(root, shift, P)
					local M, myRoot = getMuzzlePos()
					if not M then
						return 0, false
					end
					local cam = workspace.CurrentCamera
					local dir = mouseHit(cam) - M
					if dir.Magnitude < 0.1 then
						return 0, false
					end
					dir = dir.Unit
					local wall = worldRay(M, dir * 1000)
					local maxDist = wall and (wall.Position - M).Magnitude or 1000
					local clear = worldRay(M, P - M) == nil
					return hitChance(M, dir, bodyBoxes(root.Parent, shift), spreadDeg(myRoot), maxDist), clear
				end

				local function dirAngles(d)
					return math.atan2(-d.X, -d.Z), math.asin(math.clamp(d.Y, -1, 1))
				end

				local function wrap(a)
					return (a + math.pi) % (2 * math.pi) - math.pi
				end

				local function currentAngles(cam)
					return dirAngles(mouseRay(cam).Direction.Unit)
				end

				local function pointAngles(cam, pt)
					local d = pt - mouseRay(cam).Origin
					if d.Magnitude < 1e-3 then
						return currentAngles(cam)
					end
					return dirAngles(d.Unit)
				end

				local function setAngles(cam, yaw, pitch)
					local cy, cp = currentAngles(cam)
					local cf = cam.CFrame
					local rx, ry = cf:ToEulerAnglesYXZ()
					cam.CFrame = CFrame.new(cf.Position) * CFrame.fromEulerAnglesYXZ(math.clamp(rx + pitch - cp, -1.39, 1.39), ry + wrap(yaw - cy), 0)
				end

				local function quintic(x)
					x = math.clamp(x, 0, 1)
					return x * x * x * (x * (x * 6 - 15) + 10)
				end

				local function easeOutCubic(x)
					x = math.clamp(x, 0, 1)
					return 1 - (1 - x) ^ 3
				end

				local function gauss(mu, sd, lo, hi)
					local u1, u2 = math.max(math.random(), 1e-9), math.random()
					return math.clamp(mu + math.sqrt(-2 * math.log(u1)) * math.cos(2 * math.pi * u2) * sd, lo, hi)
				end

				local function flickDuration(ang)
					local k = math.clamp(math.deg(ang) / 180, 0, 1) ^ 0.72
					local base = cfg.flickMin + (cfg.flickMax - cfg.flickMin) * k
					if base <= 8 then
						return 0.001
					end
					local varPct = (cfg.flickVariance or 28) / 100
					local speedNoise = gauss(0, 0.22, -0.4, 0.5) * varPct
					local dur = base * (1 + speedNoise) / 1000
					return math.max(0.012, dur)
				end

				local seed = math.random() * 1000

				local function tremor(t, amp)
					return math.noise(t * 6, seed) * amp, math.noise(seed, t * 6) * amp
				end

				local function newStroke(y0, p0, T1, T2, over, isReturn)
					local duration = math.max(T1, 0.001)
					local settle = (T1 <= 0.015 or (over or 0) <= 0) and 0 or T2
					local landingStyle = "crisp"
					local effectiveOver = over or 0
					if not isReturn and duration > 0.03 then
						local styleRoll = math.random()
						if styleRoll < 0.42 then
							landingStyle = "overshoot"
							effectiveOver = math.max(0.02, effectiveOver * (0.7 + math.random() * 0.8))
						elseif styleRoll < 0.72 then
							landingStyle = "crisp"
							effectiveOver = 0
							settle = 0
						else
							landingStyle = "undershoot"
							effectiveOver = -math.min(0.08, math.max(0.015, (effectiveOver * 0.5)))
							settle = math.max(0.025, settle * 0.75)
						end
					end
					local perpDir = (math.random() > 0.5 and 1 or -1) * (0.15 + math.random() * 0.35)
					local arcCurve = (cfg.flickCurve and duration > 0.025) and (perpDir * (0.015 + math.random() * 0.035)) or 0
					local accelSkew = (duration > 0.02) and (0.82 + (math.random() - 0.5) * 0.28) or 1.0
					return {
						y0 = y0,
						p0 = p0,
						T1 = duration,
						T2 = settle,
						over = effectiveOver,
						landingStyle = landingStyle,
						arcCurve = arcCurve,
						accelSkew = accelSkew,
						t0 = os.clock(),
						noiseSeed = math.random() * 1000,
					}
				end

				local function strokeAngles(st, y1, p1)
					local t = os.clock() - st.t0
					local dy, dp = wrap(y1 - st.y0), p1 - st.p0
					local mag = math.sqrt(dy * dy + dp * dp)
					local oy, op = 0, 0
					local ux, uy = 0, 0
					if mag > 1e-4 then
						ux, uy = dy / mag, dp / mag
						if st.over ~= 0 then
							local o = math.clamp(mag * st.over, -math.rad(3.5), math.rad(3.5))
							oy = ux * o
							op = uy * o
						end
					end

					if t <= st.T1 then
						local u = math.clamp(t / st.T1, 0, 1)
						local s = quintic(u ^ (st.accelSkew or 1))
						local arcY, arcP = 0, 0
						if mag > 1e-4 and (st.arcCurve or 0) ~= 0 then
							local arc = math.sin(u * math.pi) * (mag * st.arcCurve)
							arcY = -uy * arc
							arcP = ux * arc
						end
						local ny, np = 0, 0
						if cfg.flickHumanNoise and st.T1 > 0.02 then
							local speedFactor = math.sin(u * math.pi)
							local nAmp = math.rad(0.035) * speedFactor
							ny = math.noise(t * 16, st.noiseSeed or 1) * nAmp
							np = math.noise(st.noiseSeed or 1, t * 16) * nAmp
						end
						return st.y0 + (dy + oy) * s + arcY + ny, st.p0 + (dp + op) * s + arcP + np, false
					end

					if (st.T2 or 0) <= 0.001 then
						return y1, p1, true
					end

					local s = easeOutCubic((t - st.T1) / st.T2)
					return st.y0 + dy + oy * (1 - s), st.p0 + dp + op * (1 - s), t >= (st.T1 + st.T2)
				end

				local fb = { state = "idle" }
				local lastFlick, lastShot = 0, 0

				local function release()
					fb.state = "idle"
					fb.root = nil
					fb.stroke = nil
				end

				local function beginReturn()
					if cfg.returnMode == "Stay" then
						release()
						return
					end
					local cam = workspace.CurrentCamera
					local y0, p0 = currentAngles(cam)
					local ry, rpch = fb.oy, fb.op
					if cfg.returnMode == "Drift" then
						local d = math.rad(cfg.drift)
						ry += gauss(0, d * 0.6, -d, d)
						rpch = math.clamp(rpch + gauss(0, d * 0.4, -d, d), -1.3, 1.3)
					end
					fb.ry, fb.rp = ry, rpch
					local ang = math.sqrt(wrap(ry - y0) ^ 2 + (rpch - p0) ^ 2)
					local dur = flickDuration(ang)
					if dur <= 0.015 then
						fb.stroke = newStroke(y0, p0, 0.001, 0, 0, true)
					else
						local T1 = math.clamp(dur * gauss(1.3, 0.12, 1.1, 1.6), 0.08, 0.34)
						fb.stroke = newStroke(y0, p0, T1, gauss(0.04, 0.008, 0.025, 0.06), cfg.returnMode == "Exact" and 0 or (cfg.overshoot / 200), true)
					end
					fb.state = "return"
				end

				local function fire()
					local gun = player.Character and player.Character:FindFirstChild("Gun")
					if not gun then
						return false
					end
					lastShot = os.clock()
					pcall(function()
						gun:Activate()
					end)
					return true
				end

				local function startFlick(root)
					if fb.state ~= "idle" or busy or nativeBusy or not root then
						return
					end
					local cam = workspace.CurrentCamera
					local char = player.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not hum or hum.Health <= 0 or cam.CameraType == Enum.CameraType.Scriptable then
						return
					end
					if not char:FindFirstChild("Gun") then
						if not cfg.autoEquip or not equipGun() then
							notify("Flickbot", "gun not equipped")
							return
						end
						local equipWait = os.clock()
						while not char:FindFirstChild("Gun") and (os.clock() - equipWait < 0.25) do
							RunService.Heartbeat:Wait()
						end
					end
					if fb.state ~= "idle" or not root.Parent or not char:FindFirstChild("Gun") then
						return
					end
					local y0, p0 = currentAngles(cam)
					local part = aimPart(root.Parent) or root
					local sz = part.Size
					local wanderX = (math.random() - 0.5) * sz.X * 0.45
					local wanderY = (math.random() - 0.4) * sz.Y * 0.45
					local wanderZ = (math.random() - 0.5) * sz.Z * 0.3
					fb.offset = Vector3.new(wanderX, wanderY, wanderZ)
					fb.root = root
					fb.oy, fb.op = y0, p0
					local P, _, selfShift = solve(root, 0.15, fb.offset)
					local ty, tp = pointAngles(cam, steerPoint(P, selfShift))
					local ang = math.sqrt(wrap(ty - y0) ^ 2 + (tp - p0) ^ 2)
					local dur = flickDuration(ang)
					local over = (dur <= 0.015) and 0 or (cfg.overshoot / 100)
					local settle = (dur <= 0.015 or over <= 0) and 0 or gauss(0.035, 0.006, 0.025, 0.045)
					fb.stroke = newStroke(y0, p0, dur, settle, over, false)
					fb.state = "forward"
					lastFlick = os.clock()
				end

				local function track2(cam, root, dt, rate)
					local P, shift, selfShift = solve(root, 0, fb.offset)
					local ty, tp = pointAngles(cam, steerPoint(P, selfShift))
					local ny, np = tremor(os.clock(), math.rad(0.05))
					local cy, cp = currentAngles(cam)
					local k = 1 - math.exp(-dt * rate)
					setAngles(cam, cy + wrap(ty - cy) * k + ny, cp + (tp - cp) * k + np)
					return P, shift
				end

