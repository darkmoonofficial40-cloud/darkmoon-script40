				local function getTarget(forAssist)
					local _, mr = getMurderer(not cfg.assistDeathlock)
					if not forAssist then
						return mr
					end
					local amMurderer = findTool(player, "Knife") ~= nil
					local allowInno = (amMurderer or cfg.assistInno or assistInnoToggled or (cfg.assistWithoutGun and not mr)) and true or false
					if cfg.assistRoleCheck and not amMurderer and mr and not allowInno then
						return mr
					end
					local cam = workspace.CurrentCamera
					local now = os.clock()

					if assistCachedTarget and assistCachedTarget.Parent and (now - assistTargetCachedAt < 0.12) then
						local cChar = assistCachedTarget.Parent
						local cHum = cChar:FindFirstChildOfClass("Humanoid")
						if (not cfg.assistDeathlock or (cHum and cHum.Health > 0)) and not inLobby(assistCachedTarget.Position) then
							local sp, inView = cam:WorldToViewportPoint(assistCachedTarget.Position)
							if inView and sp.Z > 0 then
								local locked = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
								local mpt = locked and (cam.ViewportSize / 2) or UserInputService:GetMouseLocation()
								local d = (Vector2.new(sp.X, sp.Y) - mpt).Magnitude
								if d <= cfg.assistFov * 1.25 then
									return assistCachedTarget
								end
							end
						end
					end

					assistTargetCachedAt = now
					local locked = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
					local mpt = locked and (cam.ViewportSize / 2) or UserInputService:GetMouseLocation()
					local bestRoot, bestDist = nil, math.huge
					if not amMurderer and mr and mr.Parent then
						local sp, inView = cam:WorldToViewportPoint(mr.Position)
						if inView and sp.Z > 0 then
							local d = (Vector2.new(sp.X, sp.Y) - mpt).Magnitude
							if d <= cfg.assistFov and not worldRay(cam.CFrame.Position, mr.Position - cam.CFrame.Position) then
								bestRoot = mr
								bestDist = d * 0.7
							end
						end
					end
					local sheriffTarget = nil
					local sheriffDist = math.huge
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= player then
							local char = p.Character
							local root = char and char:FindFirstChild("HumanoidRootPart")
							local hum = char and char:FindFirstChildOfClass("Humanoid")
							if root and (not cfg.assistDeathlock or (hum and hum.Health > 0)) and root ~= mr and not inLobby(root.Position) then
								local sp, inView = cam:WorldToViewportPoint(root.Position)
								if inView and sp.Z > 0 then
									local d = (Vector2.new(sp.X, sp.Y) - mpt).Magnitude
									if d <= cfg.assistFov and not worldRay(cam.CFrame.Position, root.Position - cam.CFrame.Position) then
										local isSheriff = findTool(p, "Gun") ~= nil
										if amMurderer and isSheriff then
											if d < sheriffDist then
												sheriffDist = d
												sheriffTarget = root
											end
										end
										if d < bestDist then
											bestDist = d
											bestRoot = root
										end
									end
								end
							end
						end
					end
					local res = (amMurderer and sheriffTarget) or bestRoot or mr
					assistCachedTarget = res
					return res
				end

				local function getFlickTarget()
					local _, mr = getMurderer()
					if mr and mr.Parent then
						local mHum = mr.Parent:FindFirstChildOfClass("Humanoid")
						if mHum and mHum.Health > 0 and not inLobby(mr.Position) then
