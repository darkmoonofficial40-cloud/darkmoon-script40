						tween(optLbl, 0.12, { TextColor3 = dimColor })
					end
				end)
				connect(btn.MouseButton1Click, function()
					choose(idx)
					closeDropdown()
				end)
			end

			if cur > visibleCount then
				scroll.CanvasPosition = Vector2.new(0, math.max(0, (cur - 3) * itemH))
			end
		end

		register(key, function(v)
			local i = table.find(options, v)
			if i and i ~= cur then
				choose(i)
			end
		end, function()
			return options[cur]
		end, options[table.find(options, default) or 1])

		connect(row.MouseButton1Click, function()
			openDropdown()
		end)
		connect(row.MouseButton2Click, function()
			choose((cur - 2) % n + 1)
		end)
