					end
				end
				if backtrack.style == "Trail" then
					local hrp = char:FindFirstChild("HumanoidRootPart")

					local function trail(topBar2, bottom, emission)
						local a0 = create("Attachment", { Name = "kynoxTrailA", Position = Vector3.new(0, topBar2, 0), Parent = hrp })
						local a1 = create("Attachment", { Name = "kynoxTrailB", Position = Vector3.new(0, bottom, 0), Parent = hrp })
						local tr = create("Trail", {
							Name = "kynoxTrail",
