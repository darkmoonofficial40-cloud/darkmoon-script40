				if not part:IsA("BasePart") or isPlayerChar(part) then return end
				if origMaterials[part] == nil then
					origMaterials[part] = { mat = part.Material, ref = part.Reflectance }
				end
				part.Material = Enum.Material.SmoothPlastic
				part.Reflectance = 0
			end

			local function applyDecalHide(d)
				if not (d:IsA("Decal") or d:IsA("Texture")) or isPlayerChar(d) then return end
				if origDecals[d] == nil then
					origDecals[d] = d.Transparency
				end
